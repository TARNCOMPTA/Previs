{
  "name": "@previs/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API HTTP Previs : authentification, dossiers, versions, PDF, point d'entrée MCP",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --sourcemap --external better-sqlite3 --external playwright-core",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.0.4",
    "@previs/core": "*",
    "@previs/mcp": "*",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "playwright-core": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
