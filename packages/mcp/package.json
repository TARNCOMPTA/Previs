{
  "name": "@previs/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serveur MCP Previs : outils de lecture et d'écriture des dossiers prévisionnels",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "previs-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/stdio.ts --format esm --dts --clean --sourcemap",
    "dev": "tsup src/index.ts src/stdio.ts --format esm --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@previs/core": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
