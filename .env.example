# ─── Previs — configuration serveur ───────────────────────────────────────────
# Copier en `.env` sur le VPS et adapter. Ne jamais commiter le `.env`.

# Port d'écoute de l'application (nginx fait le reverse-proxy HTTPS vers ce port)
PORT=8080
HOST=0.0.0.0

# URL publique de l'application (utilisée pour les cookies et le serveur MCP)
PUBLIC_URL=https://previs.tarncompta.fr

# Secret de signature des sessions — OBLIGATOIRE en production.
# Générer avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Emplacement de la base SQLite (montée en volume dans Docker)
DATABASE_PATH=./data/previs.db

# Compte administrateur créé au premier démarrage si la base est vide
BOOTSTRAP_ADMIN_EMAIL=aymeric@tarncompta.fr
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NOM=Aymeric HANGARD

# Cookies sécurisés (mettre à false uniquement pour un test local en http://)
SECURE_COOKIES=true

# Chemin du binaire Chromium utilisé pour générer les PDF.
# Dans l'image Docker fournie : /usr/bin/chromium
CHROMIUM_PATH=/usr/bin/chromium

# Active le point d'entrée MCP en HTTP sur /mcp (le jeton d'API reste obligatoire)
MCP_HTTP_ENABLED=true
